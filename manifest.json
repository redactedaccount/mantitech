{
  "manifest_version": 3,
  "name": "MantiTech",
  "version": "0.3.0",
  "description": "QOL features for Galactic Tycoons players.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://*.galactictycoons.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://*.galactictycoons.com/*"],
      "js": ["injected.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["*://*.galactictycoons.com/*"],
      "js": ["emoji-picker-element.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.galactictycoons.com/*"],
      "js": ["content.js"],
      "css": ["style.css"],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "mantitech@galactictycoons",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"],
        "optional": []
      }
    }
  },
  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
